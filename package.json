{
  "name": "getcrane-dev",
  "private": true,
  "type": "module",
  "description": "Сайт и документация CRANE: Hugo, GitHub Pages, RU и EN. Файл описывает зависимости; установка — npm ci.",
  "engines": { "node": ">=24" },
  "hugo": "0.157.0",
  "scripts": {
    "tokens:sync": "node scripts/sync-tokens.ts",
    "tokens:check": "node scripts/sync-tokens.ts --check",
    "mermaid": "node scripts/render-mermaid.ts",
    "mermaid:check": "node scripts/check-mermaid.ts",
    "icons:sync": "node scripts/sync-icons.ts",
    "icons:check": "node scripts/sync-icons.ts --check",
    "pagefind:dev": "node scripts/pagefind.ts --dev",
    "hugo:dev": "HUGO_ENV=development hugo server",
    "hugo:build": "node scripts/hugo.ts --minify --gc",
    "pagefind": "node scripts/pagefind.ts",
    "postbuild": "node scripts/postbuild.ts",
    "build": "npm run hugo:build && npm run pagefind && npm run postbuild",
    "build:full": "npm run mermaid && npm run build",
    "build:local": "HUGO_ENV=development node scripts/hugo.ts --gc && npm run pagefind && npm run postbuild",
    "check:content": "node scripts/check-content.ts",
    "check:roadmap": "node tools/check-roadmap.ts",
    "check:links": "node scripts/check-links.ts",
    "check:external": "node scripts/check-external.ts",
    "check:spell": "node scripts/spell.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "pagefind": "1.5.2"
  },
  "devDependencies": {
    "@cspell/dict-ru_ru": "2.3.4",
    "@mermaid-js/mermaid-cli": "12.0.0",
    "@types/node": "24.19.2",
    "cspell": "10.4.0",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
